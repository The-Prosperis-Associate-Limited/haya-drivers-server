PORT=8080
NODE_ENV=development

DATABASE_URL=

# --- Tokens -----------------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
EMAIL_VERIFICATION_TOKEN=
GOOGLE_VERIFICATION_TOKEN=

# --- Surfaces ---------------------------------------------------------------
# CLIENT_URL is where every emailed link lands. SERVER_URL is this API, used by
# the email-verification link because it hits the server before redirecting.
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SERVER_URL=http://localhost:8080
# Comma separated. Extra CORS origins for regional domains.
ALLOWED_ORIGINS=

# --- Google OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
# Native sign-in accepts a token audienced to the WEB client, not the platform
# one, so GOOGLE_WEB_CLIENT_ID is the entry that matters. With none of these set
# the native endpoint refuses every token rather than accepting any.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Email ------------------------------------------------------------------
# All mail goes through Resend; the domain must be verified there for the
# noreply@hayadrivers.com sender to work.
RESEND_API_KEY=
SENDER_EMAIL="Haya Drivers <noreply@hayadrivers.com>"
REPLYTO_EMAIL=support@hayadrivers.com
SUPPORT_EMAIL=support@hayadrivers.com

# --- Redis (BullMQ email queue + scheduled jobs) ----------------------------
# Full url, e.g. redis://user:pass@host:6379 (local tegat redis: redis://localhost:6381)
REDIS_URL=

# --- Cloudinary -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ---------------------------------------------------------------
# Paystack covers NGN/GHS/ZAR/KES today. A new region is a new PaymentProvider
# implementation plus an entry in services/payments/provider.registry.ts.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Percent taken from each completed booking before the driver is credited.
PLATFORM_FEE_PERCENT=10
# Major units, in the driver wallet currency.
MINIMUM_PAYOUT_MAJOR=1000

# --- Mobile push (Expo) -----------------------------------------------------
# Optional. Expo accepts sends without it until "enhanced security" is turned on
# in the Expo dashboard, at which point delivery stops silently without it.
EXPO_ACCESS_TOKEN=

# The client (DriverVault client) app, used for role-aware email links and OAuth redirects
CLIENT_APP_URL=http://localhost:3001

# Dedicated virtual accounts: "wema-bank" in production, "test-bank" with test keys
PAYSTACK_DVA_BANK=test-bank
# The platform cut on a wallet payment, paid by the client on top of the amount
PAYMENT_FEE_PERCENT=1
PAYMENT_FEE_MIN_MINOR=10000
PAYMENT_FEE_MAX_MINOR=200000

# Organisation account hire payments are transferred into.
ORG_BANK_NAME="Fidelity Bank"
ORG_ACCOUNT_NAME="HAYA DRIVERS LTD"
ORG_ACCOUNT_NUMBER="0000000000"

# Support chat AI (either key enables it; Groq is tried first, OpenRouter free models are the fallback).
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
