// The admin-brokered hire flow, DriversNG-style money rail: a client either
// asks for a specific driver (self-serve) or submits a concierge request with
// no driver attached - an admin assigns one at review. The admin issues a VAT
// invoice, the client pays by bank transfer into the ORGANISATION account and
// uploads proof, an admin confirms it, and the paid request materialises as an
// ACCEPTED booking plus the driver's contact details ("combo pack"). The org
// settles drivers itself - no client wallet involved.

enum HireRequestStatus {
  PENDING_REVIEW
  INVOICED
  PAYMENT_REVIEW
  PAID
  DECLINED
  CANCELLED
}

enum HireInvoiceStatus {
  UNPAID
  PAYMENT_REVIEW
  PAID
  VOID
}

enum HirePackage {
  PRIVATE
  SUBSCRIPTION
}

enum WorkSchedule {
  WEEKDAYS
  WEEKDAYS_AND_SATURDAY
  FULL_WEEK
  CUSTOM
}

model HireRequest {
  id        String @id @default(cuid())
  reference String @unique

  clientId String
  client   User   @relation("ClientHireRequests", fields: [clientId], references: [id], onDelete: Cascade)

  // Null = concierge request; an admin assigns the driver during review.
  driverId String?
  driver   User?   @relation("DriverHireRequests", fields: [driverId], references: [id], onDelete: Cascade)

  engagement_type EngagementType @default(MONTHLY)
  starts_at       DateTime
  note            String?

  // The questionnaire - what the client actually needs.
  package                HirePackage   @default(PRIVATE)
  duration_months        Int?
  drivers_needed         Int           @default(1)
  driver_type            DriverType?
  schedule               WorkSchedule  @default(WEEKDAYS)
  resumption_time        String?
  closing_time           String?
  transmission           Transmission?
  insurance_cover        String?
  provides_accommodation Boolean       @default(false)
  state                  String?
  nearest_area           String?

  status          HireRequestStatus @default(PENDING_REVIEW)
  declined_reason String?
  declined_at     DateTime?
  cancelled_at    DateTime?
  paid_at         DateTime?

  // Set when payment succeeds - the engagement the client sees in My Hire.
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  invoice HireInvoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([driverId, createdAt])
}

model HireInvoice {
  id            String      @id @default(cuid())
  reference     String      @unique
  hireRequestId String      @unique
  hire_request  HireRequest @relation(fields: [hireRequestId], references: [id], onDelete: Cascade)

  issuedById String
  issuedBy   User   @relation("InvoiceIssuer", fields: [issuedById], references: [id])

  // All minor units. total = amount + vat + fee; the driver receives amount.
  amount_minor Int
  vat_percent  Float
  vat_minor    Int
  fee_minor    Int
  total_minor  Int
  currency     String @default("NGN")

  status  HireInvoiceStatus @default(UNPAID)
  note    String?
  paid_at DateTime?

  // Proof of the bank transfer into the organisation account.
  proof_url             String?
  proof_note            String?
  proof_submitted_at    DateTime?
  proof_rejected_reason String?
  confirmedById         String?
  confirmedBy           User?   @relation("InvoiceConfirmer", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
