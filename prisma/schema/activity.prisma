enum ActivityType {
  ACCOUNT_CREATED
  PROFILE_UPDATED
  ONBOARDING_SUBMITTED
  DOCUMENT_UPLOADED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYOUT_REQUESTED
  PAYOUT_PAID
  PAYOUT_FAILED
  COURSE_COMPLETED
  CERTIFICATION_ISSUED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ADMIN_INVITED
  ADMIN_ROLE_CHANGED
  ACCOUNT_ANONYMISED
  REFERRAL_ATTACHED
  REFERRAL_APPROVED
  REFERRAL_REJECTED
  REFERRAL_REVERSED
}

model Activity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserActivity", fields: [userId], references: [id], onDelete: Cascade)

  type        ActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// One row per unique visitor per UTC day on the public pages. The key is a
// hash of ip + user agent - no PII stored, no cookie set.
model SiteVisit {
  id          String   @id @default(cuid())
  day         DateTime
  visitor_key String

  createdAt DateTime @default(now())

  @@unique([day, visitor_key])
  @@index([day])
}
