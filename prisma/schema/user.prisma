enum UserRole {
  DRIVER
  CLIENT
  ADMIN
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

model User {
  id                  String        @id @default(cuid())
  first_name          String?
  last_name           String?
  email               String        @unique
  password            String?
  phone_no            String?
  whatsapp_number     String?
  profile_pic         String?
  bio                 String?
  role                UserRole
  gender              Gender?
  date_of_birth       DateTime?
  marital_status      MaritalStatus?
  country             String?
  state_of_residence  String?
  city                String?
  address             String?
  timezone            String?
  // Auth
  has_validated_email Boolean       @default(false)
  terms_accepted_at   DateTime?
  googleId            String?       @unique
  authProvider        AuthProvider  @default(PASSWORD)
  failedLoginAttempts Int           @default(0)
  isLocked            Boolean       @default(false)
  lastLogin           DateTime      @default(now())
  account_status      AccountStatus @default(ACTIVE)
  // Sessions minted before this instant are refused. Set on password reset so
  // "signed out on all other devices" is true rather than a claim in the copy.
  sessions_valid_from DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver_profile      DriverProfile?
  driver_verification DriverVerification? @relation("DriverVerificationOwner")
  documents           DriverDocument[]    @relation("DriverDocumentOwner")
  client_profile   ClientProfile?
  admin_profile    AdminProfile?
  emailOtps        EmailOtp[]
  deviceTokens     DeviceToken[]
  pushSubscription PushSubscription?

  driver_bookings   Booking[]      @relation("DriverBookings")
  client_bookings   Booking[]      @relation("ClientBookings")
  reviews_written   Review[]       @relation("ReviewAuthor")
  reviews_received  Review[]       @relation("ReviewSubject")
  wallet            Wallet?

  staffing_requests    StaffingRequest[]    @relation("ClientStaffingRequests")
  request_applications RequestApplication[] @relation("DriverRequestApplications")
  payouts           Payout[]
  bank_accounts     BankAccount[]
  enrollments       CourseEnrollment[]
  certifications    Certification[]

  notification_preference NotificationPreference?

  received_notifications Notification[] @relation("RecipientNotifications")
  sent_notifications     Notification[] @relation("SenderNotifications")
  activities             Activity[]     @relation("UserActivity")

  created_tickets  Ticket[]        @relation("TicketCreator")
  assigned_tickets Ticket[]        @relation("TicketAssignee")
  ticket_comments  TicketComment[]

  reviewed_documents     DriverDocument[]     @relation("DocumentReviewer")
  reviewed_verifications DriverVerification[] @relation("VerificationReviewer")

  @@index([role, account_status])
}

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  client_type       ClientType @default(INDIVIDUAL)
  organisation_name String?
  organisation_size Int?
  industry          String?

  // Hiring preferences collected by the client onboarding wizard. All optional —
  // the wizard is skippable and the marketplace works without them.
  hiring_categories       ClientDriverCategory[] @default([])
  drivers_needed          DriversNeededRange?
  assignment_type         AssignmentType?
  primary_location        String?
  hiring_timeline         HiringTimeline?
  budget_range            BudgetRange?
  onboarding_completed_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  FLEET_MANAGER
  FINANCE_OFFICER
  SUPPORT_AGENT
  READ_ONLY
}

model AdminProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  admin_role AdminRole @default(READ_ONLY)
  // Set on invite. Every /api/admin route is refused while true, so the
  // temporary password cannot be used as a permanent one.
  must_change_password Boolean @default(false)
  invited_by     String?
  last_active_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ClientType {
  INDIVIDUAL
  ORGANISATION
}

enum ClientDriverCategory {
  CONTRACT
  PRIVATE
  CORPORATE
  EXECUTIVE
  SPY
  EXPATRIATE
}

enum DriversNeededRange {
  ONE
  TWO_TO_FIVE
  SIX_TO_FIFTEEN
  SIXTEEN_PLUS
}

enum AssignmentType {
  PERMANENT
  TEMPORARY
}

enum HiringTimeline {
  IMMEDIATELY
  WITHIN_TWO_WEEKS
  THIS_MONTH
  EXPLORING
}

enum BudgetRange {
  RANGE_150_200K
  RANGE_201_250K
  RANGE_251_300K
  RANGE_301K_PLUS
}
