enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  IN_PROGRESS
  COMPLETED
  DISPUTED
}

enum EngagementType {
  ONE_OFF
  DAILY
  WEEKLY
  MONTHLY
  CONTRACT
}

model Booking {
  id        String @id @default(cuid())
  reference String @unique

  clientId String
  client   User   @relation("ClientBookings", fields: [clientId], references: [id])
  driverId String?
  driver   User?  @relation("DriverBookings", fields: [driverId], references: [id])

  title           String
  description     String?
  requirements    String[]       @default([])
  driver_type     DriverType
  engagement_type EngagementType @default(ONE_OFF)

  pickup_address String
  dropoff_address String?
  country        String
  state          String
  city           String?

  starts_at DateTime
  ends_at   DateTime?

  // Copied from the hire request at payment confirmation; null on pre-brokered bookings.
  schedule        WorkSchedule?
  resumption_time String?
  closing_time    String?

  // Minor units (kobo/cents) in `currency`. Never store money as a float.
  amount   Int
  currency String @default("NGN")

  status       BookingStatus @default(REQUESTED)
  accepted_at  DateTime?
  declined_at  DateTime?
  decline_reason String?
  cancelled_at DateTime?
  cancelled_by String?
  started_at   DateTime?
  completed_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status_events BookingStatusEvent[]
  review        Review?
  transactions  WalletTransaction[]
  hire_request  HireRequest?
  attendance    Attendance[]
  salary_payments SalaryPayment[]

  @@index([driverId, status, starts_at])
  @@index([clientId, status, createdAt])
  @@index([status, starts_at])
}

// One row per booking per working day (Lagos calendar). Lateness and whether the day was on the schedule are frozen at check-in.
model Attendance {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driverId  String

  work_date      DateTime  @db.Date
  checked_in_at  DateTime
  checked_out_at DateTime?
  minutes_late   Int?
  scheduled_day  Boolean   @default(true)

  flagged_at  DateTime?
  flag_reason String?

  // An admin's ruling on the client's flag; an upheld day counts against the driver's on-time rate.
  flag_resolution      AttendanceFlagResolution?
  flag_resolution_note String?
  flag_resolved_at     DateTime?
  flag_resolved_by     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, work_date])
  @@index([driverId, checked_in_at])
  @@index([flagged_at, flag_resolved_at])
}

// One row per pay period - a month of a MONTHLY engagement counted from its start date, or the whole of a CONTRACT. The client pays the driver directly; this is the record that it happened.
model SalaryPayment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String
  driverId  String

  period_start DateTime
  period_end   DateTime
  due_at       DateTime
  amount_minor Int
  currency     String   @default("NGN")

  status SalaryPaymentStatus @default(DUE)

  paid_at     DateTime?
  receipt_url String?
  client_note String?

  confirmed_at DateTime?

  disputed_at    DateTime?
  dispute_reason String?

  resolution      SalaryDisputeResolution?
  resolution_note String?
  resolved_at     DateTime?
  resolved_by     String?

  last_reminded_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, period_start])
  @@index([status, due_at])
  @@index([driverId, paid_at])
  @@index([clientId, status])
}

enum SalaryPaymentStatus {
  DUE
  PAID
  CONFIRMED
  DISPUTED
}

enum SalaryDisputeResolution {
  PAID
  UNPAID
}

enum AttendanceFlagResolution {
  UPHELD
  DISMISSED
}

model BookingStatusEvent {
  id        String @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  from_status BookingStatus?
  to_status   BookingStatus
  changed_by  String?
  note        String?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  authorId  String
  author    User   @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id])

  rating  Int
  comment String?
  // What the client picked out: "Punctual", "Safe driving". Drives the driver's
  // "What clients mention" panel; free text stays in `comment`.
  tags    String[] @default([])
  // Per-aspect star scores from the hire review form - { Reliability: 5, ... }.
  // `rating` stays the single number everything sorts and averages on.
  criteria Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, createdAt])
}
